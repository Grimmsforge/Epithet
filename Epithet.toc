# Locale
Locales\LocaleManager.lua
Locales\enGB.lua
Locales\deDE.lua
Locales\ruRU.lua
Locales\frFR.lua
Locales\zhCN.lua

# Bundled Data
# One flavour's data per client, chosen by the client's own game type: Retail
# and PTR are "standard", WoW Forever is "camelot". Both enGB bases define the
# same EpithetData globals and their titleIDs differ, so the two sets must never
# load together, and Retail's titleID-keyed overlays never load on Forever.
# enGB is the canonical base; localised overlays load AFTER it and fall back to
# it for any field they don't translate (see docs/LOCALIZATION.md).
data\retail\TitlesDB.enGB.lua [AllowLoadGameType standard]
data\retail\TitlesDB.deDE.lua [AllowLoadGameType standard]
data\retail\TitlesDB.ruRU.lua [AllowLoadGameType standard]
data\retail\TitlesDB.frFR.lua [AllowLoadGameType standard]
data\retail\TitlesDB.zhCN.lua [AllowLoadGameType standard]
data\forever\TitlesDB.enGB.lua [AllowLoadGameType camelot]
WhatsNew\Content.lua
# Each flavour's own release notes: Retail and PTR are "standard", WoW Forever
# is "camelot". Only the current version's entry is ever shown.
WhatsNew\Retail\v1_3_0.lua [AllowLoadGameType standard]
WhatsNew\Retail\v1_3_1.lua [AllowLoadGameType standard]
WhatsNew\Retail\v1_3_2.lua [AllowLoadGameType standard]
WhatsNew\Retail\v1_4_0.lua [AllowLoadGameType standard]
WhatsNew\Forever\v1_4_0.lua [AllowLoadGameType camelot]
WhatsNew\Forever\v1_4_1.lua [AllowLoadGameType camelot]

# Core
Core\Flavor.lua
Flavors\Forever\Flavor.lua [AllowLoadGameType camelot]
Core\Theme.lua
# Per-flavour theme overrides: straight after the theme, before anything that
# reads it. Retail uses the shared theme as-is.
Flavors\Forever\Theme.lua [AllowLoadGameType camelot]
Core\SocialLayouts.lua
Core\SocialLayouts\classic.lua
Core\SocialLayouts\portrait.lua
Core\TitleData.lua
Core\Filters.lua
Core\Settings.lua
Core\SocialLayer.lua
Core\WhatsNew.lua
Core\Epithet.lua

# Developer-only local module (optional; the build strips it from public packages)
# Core\AdminCommands.local.lua

# Spotting
Spotting\TitleIndex.lua
Spotting\Log.lua
Spotting\Achievements.lua
# Each flavour's achievement list, straight after the engine.
Flavors\Retail\Achievements.lua [AllowLoadGameType standard]
Flavors\Forever\Achievements.lua [AllowLoadGameType camelot]
Spotting\Capture.lua
Spotting\LogbookUI.lua

# UI
UI\MainFrame.xml
UI\MainFrame.lua
UI\TitleList.lua
UI\Sidebar.lua
UI\Detail.lua
